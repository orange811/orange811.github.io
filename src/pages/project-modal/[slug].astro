---
import { getCollection } from "astro:content";
const { slug } = Astro.params;
const projects = await getCollection("projects").catch(() => []);
const entry = projects.find((e) => e.slug === slug || e.id === slug);

if (!entry) {
    // Render a simple 404 fragment for missing entries
}

const rendered = entry ? await entry.render() : null;

export async function getStaticPaths() {
    const all = await getCollection("projects");
    return all.map((p) => ({ params: { slug: p.slug ?? p.id } }));
}
---

<div class="project-modal-fragment">
    <header class="mb-4 relative">
        {
            entry ? (
                <a
                    class="absolute right-8 -top-2 text-muted hover:text-accent"
                    href={`/projects/${entry.slug}/`}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="View Full Page"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                    </svg>
                </a>
            ) : null
        }
        <h2 class="text-2xl font-bold">
            {entry ? entry.data.title : "Not found"}
        </h2>
        {
            entry?.data?.date ? (
                <div class="text-xs text-muted">
                    {new Date(entry.data.date).toLocaleDateString()}
                </div>
            ) : null
        }
        {
            entry?.data?.repo ? (
                <a
                    class="hover:opacity-70 transition-opacity inline-flex items-center mt-2"
                    href={entry.data.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Repository"
                >
                    <img
                        src="/logos/github/GitHub_Invertocat_Black.svg"
                        alt="GitHub"
                        class="h-6 w-6 dark:hidden"
                    />
                    <img
                        src="/logos/github/GitHub_Invertocat_White.svg"
                        alt="GitHub"
                        class="h-6 w-6 hidden dark:block"
                    />
                </a>
            ) : null
        }
    </header>

    {
        entry && rendered ? (
            <div class="prose max-w-none">
                <rendered.Content />
            </div>
        ) : (
            <div class="p-6">Not found</div>
        )
    }

    <footer class="mt-6 text-sm text-muted flex flex-wrap gap-3 items-center">
    </footer>
</div>
