---
import BaseLayout from "../layouts/BaseLayout.astro";
import experienceData from "../data/experience.json";
---

<BaseLayout
  title="Experience - Piyush Jain"
  description="Work experience and mentorship"
>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold mb-8">Experience</h1>

    <!-- Work Experience Section -->
    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Work Experience</h2>
      <div class="space-y-8">
        {
          experienceData.workExperience.map((job) => (
            <article class="border-l-4 border-border dark:border-border pl-6">
              <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-2">
                <div>
                  <h3 class="text-xl font-bold">{job.title}</h3>
                  <p class="text-muted">
                    {job.company} &bull; {job.location}
                  </p>
                </div>
                <time class="text-sm text-muted mt-1 sm:mt-0">
                  {job.period}
                </time>
              </div>
              <ul class="list-disc list-inside space-y-2 text-muted mt-4">
                {job.bullets.map((b) => (
                  <li set:html={b} />
                ))}
              </ul>
              {job.tags && job.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-4">
                  {job.tags.map((tag) => (
                    <span class="px-3 py-1 text-xs font-medium bg-surface dark:bg-surface rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <!-- Mentorship Section -->
    <section class="mb-12">
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Mentorship & Teaching</h2>
      <div class="space-y-6">
        {
          experienceData.mentorship.map((item) => (
            <article class="p-6 border border-[rgb(var(--border-color))] rounded-lg">
              <h3 class="text-xl font-bold mb-2">{item.title}</h3>
              <p class="text-muted mb-2">
                {item.org} &bull; {item.period}
              </p>
              <ul class="list-disc list-inside space-y-2 text-muted">
                {item.bullets.map((b) => (
                  <li set:html={b} />
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Skills Section -->
    <section>
      <h2 class="text-2xl md:text-3xl font-bold mb-6">Skills</h2>
      <div class="grid sm:grid-cols-2 gap-6">
        <div class="p-6 border border-[rgb(var(--border-color))] rounded-lg">
          <h3 class="text-lg font-bold mb-3">Technical</h3>
          <div class="flex flex-wrap gap-2">
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >Python</span
            >
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >JavaScript</span
            >
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >TypeScript</span
            >
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >React</span
            >
          </div>
        </div>
        <div class="p-6 border border-[rgb(var(--border-color))] rounded-lg">
          <h3 class="text-lg font-bold mb-3">Tools & Platforms</h3>
          <div class="flex flex-wrap gap-2">
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >Git</span
            >
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >Docker</span
            >
            <span
              class="px-3 py-1 text-sm bg-surface dark:bg-surface rounded-full"
              >AWS</span
            >
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
